generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The following are plain strings constrained by application code
// (kept as strings rather than enums to avoid a migration):
//   Order.status:  "negotiating" | "accepted" | "rejected" | "confirmed"
//   Bid.proposedBy: "customer" | "tailor"
//   Bid.status:     "pending" | "countered" | "accepted" | "rejected"

// id is the Firebase Auth uid — this table just adds a name + a role that's
// fixed at signup, since Firebase Auth itself has no concept of either.
// shopName is tailor-only; phone/location are required for both roles and
// shown to the other party so each side knows who they're dealing with.
model User {
  id        String   @id
  email     String   @unique
  name      String
  role      String
  shopName  String?
  phone     String?
  location  String?
  createdAt DateTime @default(now())

  categories Category[]
  products   Product[]
}

// A tailor's own grouping for their catalog (e.g. "Shirts", "Jeans", "Kurta").
// Freeform and per-tailor, not a shared taxonomy.
model Category {
  id        String   @id @default(cuid())
  tailor    User     @relation(fields: [tailorId], references: [id])
  tailorId  String
  name      String
  createdAt DateTime @default(now())

  products Product[]

  @@unique([tailorId, name])
}

// A single catalog listing: a piece of clothing a tailor offers at a given
// price, shown to customers browsing that tailor's catalog.
model Product {
  id          String   @id @default(cuid())
  tailor      User     @relation(fields: [tailorId], references: [id])
  tailorId    String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  name        String
  price       Float
  imageUrl    String?
  description String?
  createdAt   DateTime @default(now())

  @@index([tailorId])
  @@index([categoryId])
}

model Order {
  id          String   @id @default(cuid())
  customerId  String
  tailorId    String
  description String?
  status      String   @default("negotiating")
  agreedPrice Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bids    Bid[]
  payment Payment?
}

model Bid {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  amount     Float
  proposedBy String
  message    String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id                    String   @id @default(cuid())
  order                 Order    @relation(fields: [orderId], references: [id])
  orderId               String   @unique
  amount                Float
  stripePaymentIntentId String   @unique
  clientSecret          String
  status                String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
